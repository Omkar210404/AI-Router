# Copy to .env and fill in only the providers you want. Never commit .env.

# Google Gemini: has a free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: has a free tier. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI: paid. Every message costs money on your account.
OPENAI_API_KEY=

# Anthropic (Claude): paid. Every message costs money on your account.
ANTHROPIC_API_KEY=

# Ollama: local and free. Only change this if Ollama runs somewhere else.
OLLAMA_HOST=http://127.0.0.1:11434
